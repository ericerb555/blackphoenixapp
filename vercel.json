{
  "installCommand": "pnpm install",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/design",
      "destination": "https://REPLACE-WITH-DESIGN-APP.vercel.app/design"
    },
    {
      "source": "/design/:path*",
      "destination": "https://REPLACE-WITH-DESIGN-APP.vercel.app/design/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
