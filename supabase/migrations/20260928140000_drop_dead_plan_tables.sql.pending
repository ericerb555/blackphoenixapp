-- Drop the dead Postgres `plans` and `subscriptions` tables.
--
-- WHY THIS IS `.pending` AND NOT APPLIED
--
-- Because dropping a table cannot be undone, and "it has no rows" is a claim
-- that has to be checked against the actual database rather than believed from
-- reading code. Nothing in this repository references either table — no
-- `.from('plans')`, no `.from('subscriptions')`, and no migration here creates
-- them, which means they were made in the dashboard and their contents are not
-- described anywhere in version control.
--
-- Everything the platform calls a plan or a subscription lives in the KV store:
-- `plan_tier:*` for the catalogue, `feature_grant:*` for who holds what, and
-- `cohort_*` for the cohort spine. These two tables are left over from an
-- earlier shape.
--
-- HOW TO RUN IT
--
--   1. Check the row counts yourself first:
--        select count(*) from public.plans;
--        select count(*) from public.subscriptions;
--   2. Take a backup of the project regardless of what those say.
--   3. Run this against a NON-PRODUCTION project first. A drop that turns out
--      to have been wrong is not recoverable by re-running anything.
--   4. Only then rename this file to remove `.pending` and apply it.
--
-- The guard below refuses to drop a table that has any rows at all, so running
-- it by accident against a database where these are NOT dead fails loudly
-- instead of destroying data. That guard is a safety net, not a substitute for
-- steps 1 to 3.

do $$
declare
  n bigint;
begin
  if to_regclass('public.plans') is not null then
    execute 'select count(*) from public.plans' into n;
    if n > 0 then
      raise exception
        'public.plans holds % row(s); refusing to drop. Establish what they are first.', n;
    end if;
    drop table public.plans;
    raise notice 'Dropped empty table public.plans.';
  else
    raise notice 'public.plans does not exist; nothing to do.';
  end if;

  if to_regclass('public.subscriptions') is not null then
    execute 'select count(*) from public.subscriptions' into n;
    if n > 0 then
      raise exception
        'public.subscriptions holds % row(s); refusing to drop. Establish what they are first.', n;
    end if;
    drop table public.subscriptions;
    raise notice 'Dropped empty table public.subscriptions.';
  else
    raise notice 'public.subscriptions does not exist; nothing to do.';
  end if;
end $$;
