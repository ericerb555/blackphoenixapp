# ── Shared secrets for scheduled and internal callers ───────────────────────
# Each one authenticates a caller that cannot hold a user session. They are
# compared in constant time; a mismatch is a 404, not a 403, so a prober
# cannot tell a wrong secret from a wrong URL.
AUTOPILOT_CRON_SECRET=
COMPLIANCE_CRON_SECRET=
ON_CALL_CRON_SECRET=
SCREENING_CRON_SECRET=
AFFILIATE_EVENT_SECRET=
LOYALTY_EVENT_SECRET=
PAYMENT_CONFIRMATION_SECRET=
EDGE_ORIGIN_SECRET=

# ── Web push ────────────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ── Switches and policy ─────────────────────────────────────────────────────
FREEZE_ENFORCE=
IP_REPUTATION_ALLOW=
IP_REPUTATION_ENFORCE=
ORIGIN_LOCK_ENFORCE=
RENT_PLATFORM_FEE_PERCENT=
SCREENING_RETENTION_DAYS=
STELLAR_NETWORK=
COMPANY_NAME=
COMPANY_LOGO_URL=

# ── Local tooling only (never set in production) ────────────────────────────
# Read by scripts, not by the server.
SECURITY_PROBE_SITE=
SECURITY_PROBE_SECRET=
SECURITY_PROBE_VERBOSE=
SMOKE_PORT=
SMOKE_REPORT_PORT=
# Overrides the predeploy clean-tree check. If you are reaching for this, be
# certain the uncommitted changes are yours — on 2026-11-14 a deploy shipped
# another session's half-written file to production.
DEPLOY_ALLOW_DIRTY=
