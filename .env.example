# Every secret this application reads, by name, with no values.
#
# Eric: "move every secret to environmental variables and add a .env file to
# gitignore before the first commit."
#
# WHERE THESE ACTUALLY LIVE
#
# Not in a .env file. The server is a Supabase edge function, so its values are
# set as function secrets and read with `Deno.env.get`:
#
#   supabase secrets set NAME=value --project-ref plzsvzwwcdopnawtiwzm
#   supabase secrets list            # names and SHA-256 digests, never values
#
# This file is the INVENTORY — the contract of what the system needs, reviewed
# like code, so that a missing secret is a question with an answer rather than
# a 500 nobody can place. It is the one `.env*` path `.gitignore` allows
# through (`!.env.example`), which is only safe because it never holds a value.
#
# A value in this file is a leaked credential. There are no exceptions, not
# even for test keys — a Stripe test key still reaches a real account.
#
# WHAT IS PUBLIC AND IS NOT HERE
#
# `SUPABASE_ANON_KEY` is published on purpose: it ships inside the browser
# bundle, and row-level security is what stands behind it. It is in
# `src/app/utils/supabase/info.tsx` as a literal and that is correct.
# `SUPABASE_SERVICE_ROLE_KEY` is the same shape and the opposite thing — it
# passes every row-level policy, so it exists only as a function secret.
#
# Verified 2026-11-16: no credential in the working tree, and none in 1,424
# commits of history. `npm run scan:secrets` keeps the first true;
# `npm run scan:secrets -- --history` re-proves the second.

# ── Platform ────────────────────────────────────────────────────────────────
# Supabase injects the first three into every function; set them only when
# running one somewhere else.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=
APP_PUBLIC_URL=

# ── Stripe ──────────────────────────────────────────────────────────────────
# Two businesses, two accounts, hard-partitioned: neither falls back to the
# other's key and identical values are rejected outright.
STRIPE_SECRET_KEY=
STRIPE_SECRET_KEY_SERVICES=
STRIPE_SECRET_KEY_MARKETPLACE=
TBPCO_ECOMMERCE_STRIPE_SECRET_KEY=

# One signing secret per endpoint. Every incoming event is verified against
# these before anything is read; a signature that does not match is refused.
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_SERVICES=
STRIPE_WEBHOOK_SECRET_STORE=
STRIPE_WEBHOOK_SECRET_MARKETPLACE=
STRIPE_WEBHOOK_SECRET_INVESTMENTS=
STRIPE_WEBHOOK_SECRET_TEST=

# The unguessable path segment the webhook URL ends with, and the IP allowlist
# mode (unset | log | on). Both are defence in depth behind the signature.
STRIPE_WEBHOOK_PATH_SECRET=
STRIPE_WEBHOOK_IP_ALLOWLIST=
# The one account that may rehearse the paid flow with test-mode events.
STRIPE_TEST_ACCOUNT_EMAIL=

# ── AI providers ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
FAL_KEY=
RUNWAY_API_KEY=
ELEVENLABS_API_KEY=

# Model selection — configuration, not secrets, but set here so a model can be
# changed without a deploy.
ASSISTANT_VISION_MODEL=
BID_INTAKE_MODEL=
CONTENT_STUDIO_ANTHROPIC_MODEL=
CONTENT_STUDIO_EFFORT=
CONTENT_STUDIO_PROVIDER=
DESIGN_ASSISTANT_MODEL=
EXCHANGE_ASSISTANT_MODEL=
HOUSE_CAPTURE_MODEL=
HOUSE_VISION_MODEL=
INSPECTION_PLAN_MODEL=
OPENAI_IMAGE_MODEL=
