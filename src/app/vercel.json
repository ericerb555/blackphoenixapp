{
  "version": 2,
  "name": "blackphoenixbuilds",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "env": {
    "VITE_APP_NAME": "Black Phoenix Builds",
    "VITE_SUPABASE_URL": "https://plzsvzwwcdopnawtiwzm.supabase.co",
    "VITE_SUPABASE_PROJECT_ID": "plzsvzwwcdopnawtiwzm"
  }
}
