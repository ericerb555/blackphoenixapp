{
  // The test files themselves, which neither of the other two configs covers:
  // `tsconfig.json` includes only `src/**`, and `tsconfig.server.json` only the
  // edge function. An unchecked test can pass while asserting nonsense, so they
  // get a config of their own rather than being trusted.
  //
  // `allowImportingTsExtensions` is required because the tests import `.ts`
  // paths directly — that is how Node runs them, with type stripping and no
  // build step.
  //
  // No `@types/node` is installed and none is needed: leaving `types` alone lets
  // the compiler resolve `node:test` and `node:assert` without it. Verified by
  // introducing a deliberate type error and watching this config catch it, which
  // is the only way to know a checker is checking anything.
  //
  // `allowJs` is on because one test imports `api/render.js` — the Vercel
  // function that serves the public pages to crawlers. It is plain JavaScript
  // by design (see its header on why this is not Next.js), so without this the
  // import is an implicit `any` and the checker reports it. Letting TypeScript
  // infer from the JavaScript is strictly better than the alternative, which is
  // leaving the security-critical escaping in that file untested.
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["tests/**/*.ts"]
}
